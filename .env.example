# Shared settings. No AI keys here (those go in .env.ai, loaded only by the controller).
# Create your local .env with random secrets:   python scripts/init_env.py
# .env is gitignored. Never commit it.

SESSION_SECRET=
BAIT_SECRET=
ADMIN_TOKEN=

# Real site database (Olympus) -- plain Postgres
REAL_DB_HOST=db-real
REAL_DB_PORT=5432
REAL_DB_USER=hlabs
REAL_DB_NAME=hlabs
REAL_DB_PASSWORD=

# Event log database -- Postgres + TimescaleDB
EVENTS_DB_HOST=events-db
EVENTS_DB_PORT=5432
EVENTS_DB_USER=flytrap
EVENTS_DB_NAME=flytrap
EVENTS_DB_PASSWORD=

RISK_FLIP=60
RISK_REVIEW=30
POD_IDLE_RESET_MIN=10
PODS=pod-1,pod-2,pod-3,pod-4,pod-5
REAL_UPSTREAMS=web-1,web-2
