# Shared settings. No AI keys here (those go in .env.ai, loaded only by the controller).
# Create your local .env:   python scripts/init_env.py   then set DB_PASSWORD.
# .env is gitignored. Never commit it.

SESSION_SECRET=
BAIT_SECRET=
ADMIN_TOKEN=

# Databases live in your local PostgreSQL (visible in pgAdmin).
# Containers reach it through host.docker.internal.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
EVENTS_DB_NAME=flytrap
REAL_DB_NAME=hlabs

RISK_FLIP=60
RISK_REVIEW=30
POD_IDLE_RESET_MIN=10
PODS=pod-1,pod-2,pod-3,pod-4,pod-5
REAL_UPSTREAMS=web-1,web-2
