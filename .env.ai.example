# AI provider keys. Loaded ONLY by the controller container. .env.ai is gitignored.
# Fill in the providers you have; leave the rest empty.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Model ids use "provider:model". Providers: gemini, anthropic, openrouter, deepseek.
# Leave a model empty to run that agent in rules mode (no AI calls).
#   examples:  gemini:gemini-flash-latest   anthropic:claude-haiku-5-5   deepseek:deepseek-chat   openrouter:deepseek/deepseek-chat
BLUE_MODEL=
REPORT_MODEL=
RAIDER_MODEL=
RAIDER_MODEL_PROMETHEUS=
RAIDER_MODEL_PANDORA=
RAIDER_MODEL_ODYSSEUS=

RAIDER_MAX_STEPS=40
RAIDER_MAX_MINUTES=10
BLUE_INTERVAL_S=3
