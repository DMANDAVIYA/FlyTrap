# AI provider keys. Loaded ONLY by the controller container. .env.ai is gitignored.
# Fill in the keys you have; leave the rest empty. A model whose provider has no key is skipped.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
KIMI_API_KEY=
GLM_API_KEY=
MUSE_API_KEY=
OPENROUTER_API_KEY=
# Also accepted: MOONSHOT_API_KEY (Kimi), DASHSCOPE_API_KEY (Qwen), ZHIPU_API_KEY (GLM), META_API_KEY (Meta).

# Optional base URL overrides (Qwen and Kimi have international and China hosts).
#   QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   KIMI_BASE_URL=https://api.moonshot.cn/v1
#   GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Each model setting is an ordered list of "provider:model", tried left to right.
# Providers: gemini, anthropic, openai, deepseek, qwen, kimi, glm, meta, openrouter.
# BLUE_MODEL is the default for AI blue agents; BLUE_MODEL_<AGENT> overrides one agent.
# Keyless providers are skipped; a failing one falls through to the next; if none
# works the agent runs in rules mode. Model names change: check each provider's list.
# A wrong name is not fatal, it just falls through to the next entry.
# gemini-3.1-pro-preview needs a paid Gemini plan (free keys get HTTP 429); add it in front when billing is on.
BLUE_MODEL=gemini:gemini-3-flash-preview,anthropic:claude-opus-5-5,anthropic:claude-sonnet-5-5,deepseek:deepseek-v4-pro
BLUE_MODEL_ATHENA=anthropic:claude-opus-5-5,anthropic:claude-sonnet-5-5,gemini:gemini-3-flash-preview,deepseek:deepseek-v4-pro
BLUE_MODEL_HEPHAESTUS=gemini:gemini-3-flash-preview,anthropic:claude-sonnet-5-5,deepseek:deepseek-v4-pro
BLUE_MODEL_CERBERUS=meta:muse-spark-1.3,gemini:gemini-3-flash-preview,anthropic:claude-sonnet-5-5,deepseek:deepseek-v4-pro
REPORT_MODEL=anthropic:claude-opus-5-5,anthropic:claude-sonnet-5-5,gemini:gemini-3-flash-preview,deepseek:deepseek-v4-pro
RAIDER_MODEL=deepseek:deepseek-v4-pro,deepseek:deepseek-chat
RAIDER_MODEL_PROMETHEUS=deepseek:deepseek-v4-pro,deepseek:deepseek-chat
RAIDER_MODEL_PANDORA=meta:muse-spark-1.3,deepseek:deepseek-v4-pro
RAIDER_MODEL_ODYSSEUS=kimi:kimi-k3.1-pro,meta:muse-spark-1.3,deepseek:deepseek-v4-pro

RAIDER_MAX_STEPS=40
RAIDER_MAX_MINUTES=10
BLUE_INTERVAL_S=3
