# AI provider keys. Loaded ONLY by the controller container. .env.ai is gitignored.
# Fill in the keys you have; leave the rest empty. A model whose provider has no key is skipped.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
KIMI_API_KEY=
GLM_API_KEY=
OPENROUTER_API_KEY=
# Also accepted: MOONSHOT_API_KEY (Kimi), DASHSCOPE_API_KEY (Qwen), ZHIPU_API_KEY (GLM).

# Optional base URL overrides (Qwen and Kimi have international and China hosts).
#   QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   KIMI_BASE_URL=https://api.moonshot.cn/v1
#   GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Each model setting is an ordered list of "provider:model", tried left to right.
# Providers: gemini, anthropic, openai, deepseek, qwen, kimi, glm, openrouter.
# Keyless providers are skipped; a failing one falls through to the next; if none
# works the agent runs in rules mode. Model names change: check each provider's list.
# A wrong name is not fatal, it just falls through to the next entry.
BLUE_MODEL=gemini:gemini-flash-latest,anthropic:claude-haiku-5-5,openai:gpt-5-mini,deepseek:deepseek-chat,openrouter:google/gemini-2.5-flash
REPORT_MODEL=anthropic:claude-sonnet-5-5,gemini:gemini-flash-latest,openai:gpt-5-mini,deepseek:deepseek-chat
RAIDER_MODEL=deepseek:deepseek-chat,openrouter:deepseek/deepseek-chat
RAIDER_MODEL_PROMETHEUS=deepseek:deepseek-chat,openrouter:deepseek/deepseek-chat
RAIDER_MODEL_PANDORA=qwen:qwen-plus,openrouter:qwen/qwen-plus,deepseek:deepseek-chat
RAIDER_MODEL_ODYSSEUS=kimi:kimi-latest,openrouter:moonshotai/kimi-k2,glm:glm-4.6,deepseek:deepseek-chat

RAIDER_MAX_STEPS=40
RAIDER_MAX_MINUTES=10
BLUE_INTERVAL_S=3
